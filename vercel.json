{
  "version": 2,
  "name": "lab-project-monorepo",
  "builds": [
    {
      "src": "lab-project/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}